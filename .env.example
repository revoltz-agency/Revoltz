# ─────────────────────────────────────────────────────────────
# AgencyOS — environment variables (copy to .env.local)
# The app runs fully without any of these: it falls back to Demo Mode.
# NEVER commit .env.local. Keys are read on the server only.
# ─────────────────────────────────────────────────────────────

# ── Google Places API (New) ─────────────────────────────────
# Create a key in Google Cloud Console and enable "Places API (New)".
# Restrict the key to the Places API (New) and to your server IPs/refs.
# Leave empty to run in Demo Mode.
GOOGLE_PLACES_API_KEY=

# Advanced: override the Places endpoint (corporate egress proxy or tests).
# Leave empty in normal use — the default is the official Google endpoint.
GOOGLE_PLACES_BASE_URL=

# Default region for search bias / formatting (ISO 3166-1 alpha-2).
GOOGLE_PLACES_REGION_CODE=IN
# Default UI/response language (BCP-47).
GOOGLE_PLACES_LANGUAGE_CODE=en

# How many days a stored Google Places snapshot is considered fresh.
# Google's Places policies require refreshing cached place data; only
# place_id may be stored indefinitely. Stale snapshots are flagged in the UI.
GOOGLE_DATA_MAX_AGE_DAYS=30

# ── AI provider (optional) ──────────────────────────────────
# Used for: opportunity-score reasoning, website "potential opportunity",
# and personalized outreach drafts. Without a key the app generates
# copy from verified data using built-in templates (clearly labelled).
#
# Provider is auto-detected: OPENAI_API_KEY -> OpenAI-compatible,
# GEMINI_API_KEY -> Google Gemini.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, Groq, Azure-compatible, Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Safety switch: set to "false" to disable all outbound AI calls.
AI_ENABLED=true

# ── Website analysis (optional) ─────────────────────────────
# Lightweight server-side HTML heuristics (not a Lighthouse audit).
# robots.txt is always respected; set to false to disable fetching entirely.
WEBSITE_ANALYSIS_ENABLED=true
WEBSITE_ANALYSIS_TIMEOUT_MS=10000
WEBSITE_ANALYSIS_MAX_BYTES=786432
# TESTING ONLY — allows the analyzer to fetch localhost/private hosts.
# This disables the SSRF guard: leave it "false" anywhere other people can reach the app.
WEBSITE_ANALYSIS_ALLOW_PRIVATE=false

# Identifying user agent, per polite-crawler conventions.
WEBSITE_ANALYSIS_USER_AGENT=AgencyOSBot/1.0 (+https://github.com/revoltz-agency/Revoltz; lead-research)

# ── Agency defaults (used in outreach templates) ────────────
AGENCY_NAME=Revoltz
AGENCY_SENDER_NAME=Your Name
AGENCY_SENDER_EMAIL=you@youragency.com
AGENCY_WHATSAPP_NUMBER=919000000000
AGENCY_DEFAULT_CITY=Pune
# Default country calling code used to normalise WhatsApp numbers.
DEFAULT_COUNTRY_CODE=91
# Default currency for estimated deal values.
DEFAULT_CURRENCY=INR

# ── Storage ─────────────────────────────────────────────────
# V1 uses a local JSON file (swap for Postgres/Prisma in production).
# On read-only filesystems (e.g. serverless) the app runs in-memory.
AGENCYOS_DATA_FILE=./data/agencyos.json
# Set to "true" to seed the demo dataset on first boot.
AGENCYOS_SEED_DEMO=true

# ── App ─────────────────────────────────────────────────────
PORT=3000
NEXT_PUBLIC_APP_NAME=AgencyOS
