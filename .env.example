# Google Maps Platform key — used by the server only, never exposed to the browser.
# Enable Places API (New). Geocoding API is optional and enables location-radius bias.
# OpenStreetMap search needs no API key; public services are shared and rate-limited.
GOOGLE_MAPS_API_KEY=

# Local / production HTTP server port
PORT=5173

# OpenStreetMap lead search (no API key required; public services are shared/rate-limited). Set to "off" to disable.
FREE_LEAD_SEARCH=on

# Optional overrides for self-hosted or mirrored OpenStreetMap services.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# Identifying User-Agent sent to OpenStreetMap services, as their usage policies require.
# Set this to your own app name and contact address for production deployments.
# OSM_USER_AGENT=AgencyOS/1.0 (+https://example.com/contact)

# Overpass query timeout in milliseconds (default 30000).
# OVERPASS_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Audit Inbox — PLACEHOLDERS ONLY. Never commit a real value.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (e.g. a Neon pooled connection string).
# Leave blank to keep the Audit Inbox unavailable.
DATABASE_URL=

# Owner password hash in the form scrypt$<saltHex>$<hashHex>.
# Generate it locally; the password itself is never stored or committed:
#   npm run audit:hash-password
# Leave blank to keep the Audit Inbox unavailable.
AUDIT_OWNER_PASSWORD_HASH=

# Public audit intake. Keep false for local development unless you have a
# configured PostgreSQL database and an exact AUDIT_ALLOWED_ORIGINS allowlist.
AUDIT_PUBLIC_INTAKE_ENABLED=false

# Days an audit request is retained before scheduled deletion (default 89).
AUDIT_RETENTION_DAYS=89

# Exact origins allowed to make state-changing Audit Inbox requests, comma
# separated. Required in production (e.g. https://your-service.onrender.com).
# An empty list rejects every cross-origin write.
AUDIT_ALLOWED_ORIGINS=

# Owner session lifetimes in minutes: idle (renewed on use) and absolute
# (never renewed). Defaults: 480 and 1440.
AUDIT_SESSION_IDLE_MINUTES=480
AUDIT_SESSION_ABSOLUTE_MINUTES=1440

# Database TLS. Unset = require TLS for remote hosts, none for localhost.
# Set to "off" only for a local development database.
# DATABASE_SSL=off

# Set to the number of reverse-proxy hops to trust so req.ip is the real client
# address (1 behind Render's edge). 0 keeps the existing behaviour.
TRUST_PROXY_HOPS=0

# Per-client cap on Google Places calls (see docs/API_ABUSE_AND_COST_REVIEW.md).
# Applies separately to /api/places/search and /api/places/details.
# Unset / empty / malformed -> 20 per minute. Exactly 0 disables the limit and
# restores the previous unlimited behaviour. This is NOT a global spending cap:
# also set a Google Cloud quota and budget alert.
# PLACES_RATE_LIMIT_PER_MIN=20

# Optional server-only key: website discovery for OSM leads with no listed website.
# TAVILY_API_KEY=
